	$(MAKE) $(MAKESILENT) -f CMakeFiles\TinyBrowser.dir\build.make CMakeFiles/TinyBrowser.dir/src/ui/WebCanvas.cpp.s
.PHONY : src/ui/WebCanvas.cpp.s

